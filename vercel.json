{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "monkey": false,
      "monkey-*": false,
      "monkey/**": false,
      "sim": false,
      "sim-*": false,
      "sim/**": false,
      "test": false,
      "test-*": false,
      "test/**": false
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/play", "destination": "/play-monetization.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/how-to-play", "destination": "/how-to-play.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ]
}
